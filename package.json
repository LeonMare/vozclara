{
  "name": "vozclara",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VozClara — interner LEON MARÉ Tool: deutsche YouTube-Videos mit spanischen Untertiteln",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/stamp-sw.mjs",
    "preview": "vite preview --host",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy",
    "icons": "node scripts/generate-icons.mjs",
    "splash": "node scripts/generate-splash.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.90.0"
  }
}
