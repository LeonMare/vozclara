# Optional. Sets MyMemory daily quota to 50 000 chars (vs 5 000 anonymous).
# Use any contact address — MyMemory only uses it for rate-limit attribution.
VITE_TRANSLATION_EMAIL=

# Set in production (auto-written by scripts/deploy.mjs after Worker deploy).
# Leave empty for local dev — Vite proxies /api/* to localhost:8787.
VITE_API_BASE=

# Canonical public URL of the deployed frontend. Used for og:url meta,
# share URLs, exported pack footers, and the data-wipe instruction in
# /privacy. The committed .env file holds the staging default
# (vozclara.pages.dev); deploy.mjs rewrites this in .env.production
# from the active [[routes]] pattern in worker/wrangler.toml.
VITE_SITE_URL=
