# Optional. Sets MyMemory daily quota to 50 000 chars (vs 5 000 anonymous).
# Use any contact address — MyMemory only uses it for rate-limit attribution.
VITE_TRANSLATION_EMAIL=

# Set in production (auto-written by scripts/deploy.mjs after Worker deploy).
# Leave empty for local dev — Vite proxies /api/* to localhost:8787.
VITE_API_BASE=
