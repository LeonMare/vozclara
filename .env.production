# API + site URL auto-written by scripts/deploy.mjs based on the
# active [[routes]] block in worker/wrangler.toml.
VITE_API_BASE=
VITE_SITE_URL=https://vozclara.app

# Cloudflare Web Analytics beacon — privacy-friendly RUM (cookieless).
VITE_CF_BEACON_TOKEN=fdd8ac82cefe40b48534e25e876329d5

# Paddle Billing — Merchant of Record for the Founder Deal.
#
# Both values are public-safe by design (the client-token can only
# launch the overlay from domains pre-approved in the Paddle dashboard,
# and the price-id is meant to be referenced from a checkout button).
#
# Generated 20 May 2026 after Paddle's verification approved
# vozclara.app as a sales domain. The price-id corresponds to the
# €99 one-time Founder Deal under the product
# `pro_01ks30gafe4te11a1ptf28pxka`.
VITE_PADDLE_CLIENT_TOKEN=live_4bc162a9b606ea6b23f2ce33068N
VITE_PADDLE_FOUNDER_PRICE_ID=pri_01ks30tgbj097qbtjhebzqyf2z


